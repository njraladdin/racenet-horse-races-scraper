<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Horse Racing Sectional & Forms Data</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">Racenet.com.au Sectional & Forms Data</a>
    </div>
  </nav>

  <div class="container mt-3">
    {{{body}}}
  </div>

  <footer class="mt-5">
    <div class="container text-center">
      <p>Horse Racing Sectional & Forms Data Viewer</p>
    </div>
  </footer>

  <!-- Loading overlay -->
  <div id="loading-overlay" class="loading-overlay" style="display: none;">
    <div class="spinner-border loading-spinner text-light" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    <h5 id="loading-message">Processing...</h5>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const loadingOverlay = document.getElementById('loading-overlay');
      const loadingMessage = document.getElementById('loading-message');
      
      // Function to show loading overlay
      function showLoading(message) {
        loadingMessage.textContent = message || 'Processing...';
        loadingOverlay.style.display = 'flex';
      }
      
      // Function to hide loading overlay
      function hideLoading() {
        loadingOverlay.style.display = 'none';
      }
      
      // Add loading indicator for all zip download links
      document.querySelectorAll('a[href*="/download-day/"], a[href*="/download-all/"]').forEach(link => {
        link.addEventListener('click', function(e) {
          // Don't show loading for right-clicks (context menu)
          if (e.button !== 2 && !e.ctrlKey) {
            const isAllData = this.getAttribute('href').includes('/download-all/');
            const message = isAllData ? 'Creating ZIP archive of all data...' : 'Creating ZIP archive of this day...';
            showLoading(message);
            
            // Hide loading after a timeout even if download doesn't start
            // This is a fallback in case something goes wrong
            setTimeout(hideLoading, 30000);
          }
        });
      });
      
      // Handle date selection
      document.querySelectorAll('.date-selector').forEach(function(dateLink) {
        dateLink.addEventListener('click', async function(e) {
          e.preventDefault();
          const type = this.getAttribute('data-type');
          const date = this.getAttribute('data-date');
          const targetElement = document.getElementById(`${type}-meetings`);
          
          // Update heading
          const headingElement = document.getElementById(`${type}-heading`);
          if (headingElement) {
            headingElement.textContent = `Meetings for ${date}:`;
          }
          
          // Update download day button
          const downloadDayBtn = headingElement.parentElement.querySelector('.btn');
          if (downloadDayBtn) {
            downloadDayBtn.href = `/download-day/${type}/${date}`;
            
            // Make sure the new button also has the loading handler
            downloadDayBtn.onclick = function(e) {
              if (e.button !== 2 && !e.ctrlKey) {
                showLoading('Creating ZIP archive of this day...');
                setTimeout(hideLoading, 30000); // Safety timeout
              }
            };
          }
          
          // Set active class
          document.querySelectorAll(`.${type}-date`).forEach(el => el.classList.remove('active'));
          this.classList.add('active');
          
          // Show loading state
          targetElement.innerHTML = '<div class="text-center mt-3 mb-3"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';
          
          try {
            const response = await fetch(`/api/${type}/${date}`);
            const meetings = await response.json();
            
            if (meetings.length === 0) {
              targetElement.innerHTML = '<div class="alert alert-info">No meetings found for this date.</div>';
              return;
            }
            
            // Set button class based on type
            let btnClass = 'btn-primary';
            if (type === 'weekly' || type === 'forms-weekly') btnClass = 'btn-success';
            
            // Render meetings as a table
            let html = `
              <div class="table-responsive">
                <table class="table table-striped">
                  <thead>
                    <tr>
                      <th>Meeting</th>
                      <th>Last Updated</th>
                      <th>Size</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>`;
            
            meetings.forEach(meeting => {
              html += `
                <tr>
                  <td>${meeting.name}</td>
                  <td>${meeting.lastModifiedFormatted}</td>
                  <td>${meeting.sizeFormatted}</td>
                  <td>
                    <a href="/download/${type}/${date}/${meeting.name}" class="btn btn-sm ${btnClass}">Download</a>
                  </td>
                </tr>`;
            });
            
            html += `
                  </tbody>
                </table>
              </div>`;
            
            targetElement.innerHTML = html;
          } catch (error) {
            console.error('Error:', error);
            targetElement.innerHTML = '<div class="alert alert-danger">Failed to load meetings</div>';
          }
        });
      });
      
      // Hide loading overlay when the page is unloaded (navigating away)
      window.addEventListener('beforeunload', hideLoading);
    });
  </script>
</body>
</html> 